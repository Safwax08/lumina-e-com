# Environment Configuration Example
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Frontend Origin for CORS & Cookie Domain
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Connection String (supports Neon, Supabase, local Postgres, etc.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumina_db

# Security & Secrets
JWT_SECRET=super-secret-jwt-key-replace-in-production
COOKIE_SECRET=super-secret-cookie-key-replace-in-production

# Seed Admin Credentials (used by npm run db:admin)
ADMIN_EMAIL=admin@lumina.com
ADMIN_PASSWORD=AdminSecurePass123!
