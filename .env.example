# Frontend Environment Configuration
VITE_API_URL=/api/v1

# Docker Compose / Production Container Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lumina_db

# Security & Secret Keys (Replace with strong random strings in production!)
JWT_SECRET=super-secret-jwt-key-replace-in-production
COOKIE_SECRET=super-secret-cookie-key-replace-in-production

# Initial Admin User Credentials
ADMIN_EMAIL=admin@lumina.com
ADMIN_PASSWORD=AdminSecurePass123!

# Google Gemini AI API Key (Server-side only)
GEMINI_API_KEY=your_gemini_api_key_here
